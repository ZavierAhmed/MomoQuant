<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.16" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MomoQuant.Api\MomoQuant.Api.csproj" />
    <ProjectReference Include="..\MomoQuant.AuditRestartHarness\MomoQuant.AuditRestartHarness.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyAuditRestartHarnessOutput" AfterTargets="Build">
    <ItemGroup>
      <AuditRestartHarnessOutput Include="$(MSBuildProjectDirectory)\..\MomoQuant.AuditRestartHarness\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>

    <Error Condition="'@(AuditRestartHarnessOutput)' == ''"
           Text="The MomoQuant.AuditRestartHarness build output is missing. Build the integration test project so its harness dependency is produced." />
    <MakeDir Directories="$(OutDir)AuditRestartHarness" />
    <Copy SourceFiles="@(AuditRestartHarnessOutput)"
          DestinationFiles="@(AuditRestartHarnessOutput->'$(OutDir)AuditRestartHarness\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
